# PostgreSQL connection string — the SAME database the tender-intelligence app
# uses. That app owns the schema and applies the migrations; this service only
# reads the company profile and writes tenders and scores.
#
# Local development (matches docker-compose.yml, which publishes 5433):
DATABASE_URL=postgresql://pguser:pgpass123@localhost:5433/tender-intelligence
# Railway: reference the attached Postgres plugin instead of pasting a URL —
#   DATABASE_URL=${{Postgres.DATABASE_URL}}
# Supabase example:
#   DATABASE_URL=postgresql://postgres:<password>@db.<project>.supabase.co:5432/postgres

# Connection pool sizing (tune down on small instances).
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

# --- Crawl ----------------------------------------------------------------
# How far back each run reaches, and how many notices per upstream page.
CRAWL_DAYS=7
CRAWL_ROWS=500
# Which feed to crawl: all, worldbank or adb. Leave as `all` in production —
# a single source is for debugging one bank without re-walking the other.
CRAWL_SOURCE=all
# How often the `serve` and `worker` roles run the full cycle. Ignored by the
# `cron` role, where the schedule belongs to the platform's own cron instead.
CRAWL_INTERVAL_HOURS=12

LOG_LEVEL=INFO

# --- Trigger endpoint (the `serve` role) ----------------------------------
# The dashboard's "Start crawling" button POSTs to /crawl on this service, so
# the two sides share a secret. Set the SAME value as the app's
# CRAWLER_TRIGGER_TOKEN; the server refuses to start without one, since an
# unauthenticated endpoint would let anything that can reach the service spend
# the crawl's LLM budget. Generate one with:  openssl rand -hex 32
CRAWLER_TRIGGER_TOKEN=
# Port the trigger endpoint listens on. Railway sets PORT itself.
PORT=8080
# Run one cycle immediately on start, rather than waiting a full interval. Off
# by default so a redeploy does not spend an LLM budget nobody asked for.
CRAWL_ON_BOOT=false

# --- ADB search index -----------------------------------------------------
# ADB's tender listing is drawn in the browser from a hosted Solr index, and
# these are the endpoint and read-only token its own public page uses. Neither
# normally needs setting: the defaults are compiled in, and these exist so a
# rotated token can be fixed by configuration rather than by a release.
#
# A crawl that stops with "ADB search index rejected our token" means it has
# been rotated. To find the current one, open
# https://www.adb.org/projects/tenders in a browser, and in the network panel
# read the Authorization header of the request it makes to searchstax.com.
# ADB_SEARCH_URL=https://searchcloud-2-ap-southeast-1.searchstax.com/29847/tenders-11959/emselect
# ADB_SEARCH_TOKEN=

# --- Claude (LLM tender assessment) --------------------------------------
# Without a key the job still crawls and heuristically scores; it just skips the
# assessment stage rather than failing.
ANTHROPIC_API_KEY=sk-ant-...
# Any current Claude model. Haiku 4.5 is the cost-effective default for the
# volume of notices involved; a larger model gives sharper judgement per notice.
ANTHROPIC_MODEL=claude-haiku-4-5
# How many shortlisted tenders Claude reads per run, and how many at a time.
LLM_LIMIT=300
LLM_CONCURRENCY=4
# Set to true to skip the assessment stage without removing the API key.
SKIP_LLM=false

# --- docker-compose only --------------------------------------------------
# Consumed by docker-compose.yml when it creates the local database container.
POSTGRES_USER=pguser
POSTGRES_PASSWORD=pgpass123
POSTGRES_DB=tender-intelligence
POSTGRES_PORT=5433
