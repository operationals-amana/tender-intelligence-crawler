# PostgreSQL connection string.
# Local development (matches docker-compose.yml, which publishes 5433):
DATABASE_URL=postgresql://pguser:pgpass123@localhost:5433/tender-intelligence
# Railway: reference the attached Postgres plugin instead of pasting a URL —
#   DATABASE_URL=${{Postgres.DATABASE_URL}}
# Supabase example:
#   DATABASE_URL=postgresql://postgres:<password>@db.<project>.supabase.co:5432/postgres

# Connection pool sizing (tune down on small Railway instances).
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

# Comma-separated list of allowed frontend origins. Use * only in development;
# in production set it to the Vercel URL, e.g.
#   CORS_ORIGINS=https://tender-intelligence.vercel.app
CORS_ORIGINS=*

# How often the scheduled crawler runs, and how far back each run reaches.
CRAWL_INTERVAL_HOURS=6
CRAWL_DAYS=7
CRAWL_ROWS=500

LOG_LEVEL=INFO

# Let the app create missing tables at startup. Convenient locally; set to
# false in deployments, where `alembic upgrade head` owns the schema.
AUTO_CREATE_TABLES=true

# The container entrypoint runs `alembic upgrade head` before starting. Set to
# false on the worker service so it does not race the API service's migration.
RUN_MIGRATIONS=true

# Port the API binds to. Railway injects this; locally it defaults to 8000.
# PORT=8000

# Where the seeders look for the AMANA spreadsheets. Defaults to ./data in this
# repository; only set this if the files are mounted from elsewhere.
# COMPANY_DATA_DIR=/mnt/company-data

# --- Claude (LLM tender assessment) --------------------------------------
# Required for `python score_tenders.py --llm`.
ANTHROPIC_API_KEY=sk-ant-...
# Any current Claude model. Haiku 4.5 is the cost-effective default for the
# volume of notices involved; a larger model gives sharper judgement per notice.
ANTHROPIC_MODEL=claude-haiku-4-5

# --- Auth -----------------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me
ACCESS_TOKEN_TTL_HOURS=12

# Seed credentials for the first user, read by `python -m api.seed.run_all`.
# Leave SEED_USER_PASSWORD unset to have one generated and printed once.
SEED_USER_EMAIL=operationals@amana.id
SEED_USER_PASSWORD=
SEED_USER_NAME=AMANA Operations

# --- docker-compose only --------------------------------------------------
# Consumed by docker-compose.yml when it creates the local database container.
POSTGRES_USER=pguser
POSTGRES_PASSWORD=pgpass123
POSTGRES_DB=tender-intelligence
POSTGRES_PORT=5433
API_PORT=8000
