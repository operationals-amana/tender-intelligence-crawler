# Keep the build context small and, more importantly, keep secrets and host
# state out of the image. Everything else in the repo is copied.
.git
.gitignore
.env
.env.*
!.env.example

__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

venv/
.venv/
env/

.scrapy/
*.log
*.sqlite3

.idea/
.vscode/
.DS_Store

Dockerfile
.dockerignore
docker-compose*.yml
DEPLOYMENT.md
